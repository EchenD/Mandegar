{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "sanity/**/*.ts",
    "sanity/**/*.tsx",
    "next.config.ts",
    "sanity.config.ts",
    "sanity.cli.ts",
    ".next-static/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "node_modules.preseed",
    ".next",
    "tests"
  ]
}
